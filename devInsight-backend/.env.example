# ============ DevInsight Backend — Environment Variables ============
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/DevInsight2
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123

# JWT
JWT_SECRET=devinsight-super-secret-key-please-change-in-production-2024-very-long-secret

# AI keys (optional)
ANTHROPIC_API_KEY=
GOOGLE_SPEECH_API_KEY=
GOOGLE_TTS_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
